{
  "name": "obsidian-personal-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A safe, local-first personal knowledge agent for Obsidian.",
  "scripts": {
    "dev": "node apps/obsidian-plugin/esbuild.config.mjs",
    "build": "node apps/obsidian-plugin/esbuild.config.mjs production",
    "build:agent-ui": "npm --prefix apps/local-agent/src/agent/web/frontend run build",
    "start:agent": "python -m agent.web.server --host 127.0.0.1 --port 8000",
    "check": "tsc --noEmit -p apps/obsidian-plugin/tsconfig.json",
    "test": "npm run test:plugin",
    "test:plugin": "esbuild apps/obsidian-plugin/tests/url.test.ts --bundle --platform=node --format=cjs --outdir=.test-build && node --test .test-build/url.test.js",
    "test:python": "python -m pytest -q -p no:cacheprovider -o asyncio_default_fixture_loop_scope=function tests/unit",
    "verify": "npm run check && npm run test:plugin && npm run test:python && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2"
  }
}
