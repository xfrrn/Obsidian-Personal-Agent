{
  "name": "obsidian-personal-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A safe, local-first personal knowledge agent for Obsidian.",
  "scripts": {
    "dev": "node apps/obsidian-plugin/esbuild.config.mjs",
    "build": "node apps/obsidian-plugin/esbuild.config.mjs production",
    "check": "tsc --noEmit -p apps/obsidian-plugin/tsconfig.json",
    "test": "npm run test:plugin",
    "test:plugin": "esbuild apps/obsidian-plugin/tests/protocol.test.ts apps/obsidian-plugin/tests/file-references.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./apps/obsidian-plugin/tests/obsidian-stub.ts --outdir=.test-build && node --test .test-build/protocol.test.js .test-build/file-references.test.js",
    "test:python": "python -m pytest -q -p no:cacheprovider tests/unit",
    "verify": "npm run check && npm run test:plugin && npm run test:python && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2"
  }
}
