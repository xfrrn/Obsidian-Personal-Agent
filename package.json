{
  "name": "obsidian-personal-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A safe, local-first personal knowledge agent for Obsidian.",
  "scripts": {
    "dev": "node apps/obsidian-plugin/esbuild.config.mjs",
    "build": "node apps/obsidian-plugin/esbuild.config.mjs production",
    "check": "tsc --noEmit -p apps/obsidian-plugin/tsconfig.json",
    "test": "esbuild apps/obsidian-plugin/tests/protocol.test.ts apps/obsidian-plugin/tests/operations.test.ts apps/obsidian-plugin/tests/operation-executor.test.ts apps/obsidian-plugin/tests/search-notes.test.ts apps/obsidian-plugin/tests/list-tasks.test.ts apps/obsidian-plugin/tests/file-references.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./apps/obsidian-plugin/tests/obsidian-stub.ts --outdir=.test-build && node --test .test-build/*.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2"
  }
}
