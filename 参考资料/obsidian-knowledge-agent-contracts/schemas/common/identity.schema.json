{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.obsidian-knowledge-agent.dev/contracts/v1/common/identity.schema.json",
  "title": "Contract identity types",
  "description": "Reusable identifiers, versions, hashes and paths used by the contracts.",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "messageId": {
      "$ref": "#/$defs/identifier"
    },
    "requestId": {
      "$ref": "#/$defs/identifier"
    },
    "sessionId": {
      "$ref": "#/$defs/identifier"
    },
    "correlationId": {
      "$ref": "#/$defs/identifier"
    },
    "traceId": {
      "$ref": "#/$defs/identifier"
    },
    "vaultId": {
      "$ref": "#/$defs/identifier"
    },
    "noteId": {
      "$ref": "#/$defs/identifier"
    },
    "operationId": {
      "$ref": "#/$defs/identifier"
    },
    "planId": {
      "$ref": "#/$defs/identifier"
    },
    "executionId": {
      "$ref": "#/$defs/identifier"
    },
    "jobId": {
      "$ref": "#/$defs/identifier"
    },
    "pluginId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "capabilityId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "vaultRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*\\\\).+$",
      "description": "A forward-slash-separated path relative to the root of an Obsidian vault. Parent traversal must also be rejected by application-level validation."
    }
  }
}
