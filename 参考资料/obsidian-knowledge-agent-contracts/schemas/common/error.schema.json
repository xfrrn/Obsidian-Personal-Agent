{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.obsidian-knowledge-agent.dev/contracts/v1/common/error.schema.json",
  "title": "Protocol error",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "category": {
      "type": "string",
      "enum": [
        "validation",
        "authentication",
        "authorization",
        "not-found",
        "conflict",
        "rate-limit",
        "timeout",
        "model",
        "storage",
        "plugin",
        "operation",
        "protocol",
        "internal"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    },
    "fieldErrors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "field",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "traceId": {
      "$ref": "identity.schema.json#/$defs/traceId"
    },
    "timestamp": {
      "$ref": "timestamp.schema.json#/$defs/dateTime"
    }
  },
  "required": [
    "code",
    "message",
    "category",
    "retryable"
  ],
  "additionalProperties": false
}
