{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.obsidian-knowledge-agent.dev/contracts/v1/common/source.schema.json",
  "title": "Message source",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "obsidian-plugin",
        "local-agent",
        "gateway",
        "admin-web",
        "automation",
        "system"
      ]
    },
    "instanceId": {
      "$ref": "identity.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "identity.schema.json#/$defs/semanticVersion"
    },
    "deviceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "channel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "instanceId",
    "version"
  ],
  "additionalProperties": false
}
