{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.obsidian-knowledge-agent.dev/contracts/v1/protocol/capability.schema.json",
  "title": "Capability descriptor",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "../common/identity.schema.json#/$defs/capabilityId"
    },
    "version": {
      "$ref": "../common/identity.schema.json#/$defs/protocolVersion"
    },
    "available": {
      "type": "boolean",
      "default": true
    },
    "riskLevel": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "unavailableReason": {
      "type": "string",
      "maxLength": 512
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "version",
    "available"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "available": {
            "const": false
          }
        },
        "required": [
          "available"
        ]
      },
      "then": {
        "required": [
          "unavailableReason"
        ]
      }
    }
  ],
  "additionalProperties": false
}
