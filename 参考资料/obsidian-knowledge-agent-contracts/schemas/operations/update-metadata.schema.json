{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.obsidian-knowledge-agent.dev/contracts/v1/operations/update-metadata.schema.json",
  "title": "Update note metadata operation",
  "allOf": [
    {
      "$ref": "operation-base.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "update-metadata"
        },
        "input": {
          "type": "object",
          "properties": {
            "path": {
              "$ref": "../common/identity.schema.json#/$defs/vaultRelativePath"
            },
            "expectedMetadataHash": {
              "$ref": "../common/identity.schema.json#/$defs/sha256"
            },
            "set": {
              "type": "object",
              "additionalProperties": true
            },
            "remove": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "addTags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "removeTags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "path",
            "expectedMetadataHash"
          ],
          "anyOf": [
            {
              "required": [
                "set"
              ]
            },
            {
              "required": [
                "remove"
              ]
            },
            {
              "required": [
                "addTags"
              ]
            },
            {
              "required": [
                "removeTags"
              ]
            }
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "input"
      ]
    }
  ],
  "unevaluatedProperties": false
}
