{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.obsidian-knowledge-agent.dev/contracts/v1/operations/operation-base.schema.json",
  "title": "Base knowledge operation",
  "description": "Common fields inherited by every concrete operation. Concrete schemas must close the object with unevaluatedProperties false.",
  "type": "object",
  "properties": {
    "operationId": {
      "$ref": "../common/identity.schema.json#/$defs/operationId"
    },
    "type": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "riskLevel": {
      "$ref": "operation-support.schema.json#/$defs/riskLevel"
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "$ref": "../common/identity.schema.json#/$defs/operationId"
      },
      "uniqueItems": true
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/precondition"
      }
    },
    "expectedResult": {
      "$ref": "#/$defs/expectedResult"
    },
    "idempotencyKey": {
      "$ref": "../common/identity.schema.json#/$defs/idempotencyKey"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 600000
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "operationId",
    "type",
    "order",
    "description",
    "reason",
    "riskLevel",
    "dependsOn",
    "preconditions",
    "idempotencyKey"
  ],
  "$defs": {
    "precondition": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "file-exists",
            "file-not-exists",
            "version-match",
            "content-hash-match",
            "metadata-hash-match",
            "plugin-available",
            "permission-granted",
            "folder-exists"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "expected": {},
        "failureCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      },
      "required": [
        "type",
        "target"
      ],
      "additionalProperties": false
    },
    "expectedResult": {
      "type": "object",
      "properties": {
        "affectedPaths": {
          "type": "array",
          "items": {
            "$ref": "../common/identity.schema.json#/$defs/vaultRelativePath"
          },
          "uniqueItems": true
        },
        "resultDescription": {
          "type": "string",
          "maxLength": 1024
        },
        "expectedVersionHash": {
          "$ref": "../common/identity.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
