{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.obsidian-knowledge-agent.dev/contracts/v1/operations/move-note.schema.json",
  "title": "Move note operation",
  "allOf": [
    {
      "$ref": "operation-base.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "move-note"
        },
        "input": {
          "type": "object",
          "properties": {
            "sourcePath": {
              "$ref": "../common/identity.schema.json#/$defs/vaultRelativePath"
            },
            "targetPath": {
              "$ref": "../common/identity.schema.json#/$defs/vaultRelativePath"
            },
            "expectedVersionHash": {
              "$ref": "../common/identity.schema.json#/$defs/sha256"
            },
            "updateLinks": {
              "type": "boolean"
            },
            "conflictPolicy": {
              "type": "string",
              "enum": [
                "fail",
                "rename",
                "merge"
              ]
            }
          },
          "required": [
            "sourcePath",
            "targetPath",
            "expectedVersionHash",
            "updateLinks",
            "conflictPolicy"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "input"
      ]
    }
  ],
  "unevaluatedProperties": false
}
