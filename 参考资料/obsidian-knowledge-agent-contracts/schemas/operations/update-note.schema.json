{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.obsidian-knowledge-agent.dev/contracts/v1/operations/update-note.schema.json",
  "title": "Update note operation",
  "allOf": [
    {
      "$ref": "operation-base.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "update-note"
        },
        "input": {
          "type": "object",
          "properties": {
            "path": {
              "$ref": "../common/identity.schema.json#/$defs/vaultRelativePath"
            },
            "expectedVersionHash": {
              "$ref": "../common/identity.schema.json#/$defs/sha256"
            },
            "updateMode": {
              "type": "string",
              "enum": [
                "patch",
                "replace-section",
                "replace-content"
              ]
            },
            "patches": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/textPatch"
              }
            },
            "section": {
              "$ref": "#/$defs/sectionReplacement"
            },
            "content": {
              "type": "string"
            },
            "preserveFrontmatter": {
              "type": "boolean",
              "default": true
            }
          },
          "required": [
            "path",
            "expectedVersionHash",
            "updateMode"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "updateMode": {
                    "const": "patch"
                  }
                },
                "required": [
                  "updateMode"
                ]
              },
              "then": {
                "required": [
                  "patches"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "updateMode": {
                    "const": "replace-section"
                  }
                },
                "required": [
                  "updateMode"
                ]
              },
              "then": {
                "required": [
                  "section"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "updateMode": {
                    "const": "replace-content"
                  }
                },
                "required": [
                  "updateMode"
                ]
              },
              "then": {
                "required": [
                  "content"
                ]
              }
            }
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "input"
      ]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "textPatch": {
      "type": "object",
      "properties": {
        "patchId": {
          "$ref": "../common/identity.schema.json#/$defs/identifier"
        },
        "startOffset": {
          "type": "integer",
          "minimum": 0
        },
        "endOffset": {
          "type": "integer",
          "minimum": 0
        },
        "oldTextHash": {
          "$ref": "../common/identity.schema.json#/$defs/sha256"
        },
        "newText": {
          "type": "string"
        },
        "contextBefore": {
          "type": "string",
          "maxLength": 512
        },
        "contextAfter": {
          "type": "string",
          "maxLength": 512
        }
      },
      "required": [
        "patchId",
        "startOffset",
        "endOffset",
        "oldTextHash",
        "newText"
      ],
      "additionalProperties": false
    },
    "sectionReplacement": {
      "type": "object",
      "properties": {
        "headingPath": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "expectedSectionHash": {
          "$ref": "../common/identity.schema.json#/$defs/sha256"
        },
        "newContent": {
          "type": "string"
        },
        "includeHeading": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "headingPath",
        "expectedSectionHash",
        "newContent"
      ],
      "additionalProperties": false
    }
  }
}
