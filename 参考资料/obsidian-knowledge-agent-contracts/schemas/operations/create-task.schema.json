{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.obsidian-knowledge-agent.dev/contracts/v1/operations/create-task.schema.json",
  "title": "Create task operation",
  "allOf": [
    {
      "$ref": "operation-base.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "create-task"
        },
        "input": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "description": {
              "type": "string",
              "maxLength": 8192
            },
            "project": {
              "type": "string",
              "maxLength": 256
            },
            "dueDate": {
              "$ref": "../common/timestamp.schema.json#/$defs/dateTime"
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "urgent"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "todo",
                "doing",
                "blocked",
                "done",
                "cancelled"
              ]
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "targetPath": {
              "$ref": "../common/identity.schema.json#/$defs/vaultRelativePath"
            },
            "sourceNotePath": {
              "$ref": "../common/identity.schema.json#/$defs/vaultRelativePath"
            }
          },
          "required": [
            "title",
            "priority",
            "status",
            "targetPath"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "input"
      ]
    }
  ],
  "unevaluatedProperties": false
}
