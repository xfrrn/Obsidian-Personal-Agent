{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.obsidian-knowledge-agent.dev/contracts/v1/operations/invoke-plugin.schema.json",
  "title": "Invoke an approved Obsidian plugin capability",
  "allOf": [
    {
      "$ref": "operation-base.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "invoke-plugin"
        },
        "input": {
          "type": "object",
          "properties": {
            "pluginId": {
              "$ref": "../common/identity.schema.json#/$defs/pluginId"
            },
            "capability": {
              "$ref": "../common/identity.schema.json#/$defs/capabilityId"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": true
            },
            "requiresPluginVersion": {
              "$ref": "../common/identity.schema.json#/$defs/semanticVersion"
            }
          },
          "required": [
            "pluginId",
            "capability",
            "parameters"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "input"
      ]
    }
  ],
  "unevaluatedProperties": false
}
